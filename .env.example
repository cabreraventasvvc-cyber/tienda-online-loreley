# =========================================================================
# VARIABLES DE ENTORNO - LORELEY TIENDA ONLINE
# =========================================================================

# 1. Base de Datos SQLite (Local) o PostgreSQL (Producción)
DATABASE_URL="file:./dev.db"

# 2. URL Pública de la Aplicación
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 3. Pasarela de Pagos Mercado Pago (Checkout Pro Oficial)
# Obtené tus credenciales desde: https://www.mercadopago.com.ar/developers/panel/app
# Para pruebas locales utilizá un Access Token de prueba (TEST-...)
MP_ACCESS_TOKEN="TEST-0000000000000000-000000-00000000000000000000000000000000-000000000"
MP_PUBLIC_KEY="TEST-00000000-0000-0000-0000-000000000000"

# 4. Clave Secreta para Sesión Administrativa
ADMIN_JWT_SECRET="loreley_super_secret_jwt_key_2026_change_in_production"

# 5. Usuario inicial para ejecutar prisma db seed
ADMIN_EMAIL="admin@loreley.com"
ADMIN_PASSWORD="cambiar-por-una-contrasena-segura"
